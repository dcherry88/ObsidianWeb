# --- Fast Note Sync source ---
FNS_TOKEN=
FNS_VAULT=MyVault
FNS_SYNC_INTERVAL=60
# Must equal the token's "Client restriction" in the FNS admin panel (or use * there)
FNS_CLIENT=ObsidianWeb
# Optional: 1 = show each editor as the FNS client type "ObsidianWeb-<person>". The token's Client restriction must then be a wildcard such as ObsidianWeb*
FNS_CLIENT_PER_USER=
# Editing on the hosted site: set to 1 to enable. The FNS token must also allow note writes.
ALLOW_WRITE=
# Set to your vault's attachment folder if it differs (the .obsidian settings are not synced):
ATTACHMENT_FOLDER=Attachments

# --- Public URL and OIDC login (Pocket ID, Entra ID, Authentik, Keycloak, ...) ---
# Leave OIDC_ISSUER empty to disable login (private network only: the API is then open to anyone who can reach it).
PUBLIC_URL=https://notes.example.com
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: restrict who may sign in (comma-separated). Groups are matched against the ID token's
# groups/roles claims. The IdP must still restrict who can create accounts; this is a second gate.
#OIDC_ALLOWED_EMAILS=
#OIDC_ALLOWED_GROUPS=
# Optional: space-separated scopes (default "openid profile email"), session lifetime in hours (default 168).
#OIDC_SCOPES=
#SESSION_TTL_HOURS=
# Local development only: allow cleartext IdP traffic. The server refuses to start with this set when PUBLIC_URL is https.
#OIDC_ALLOW_INSECURE=

DEFAULT_LAYOUT=doc
